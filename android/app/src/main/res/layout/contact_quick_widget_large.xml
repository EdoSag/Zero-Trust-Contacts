<?xml version="1.0" encoding="utf-8"?>
<!-- One contact at 2x2 and up (W7): big photo, name and number, then Call
     and Message buttons. A tap anywhere else does what was picked. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    style="@style/ZtWidget.Root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp">
        <TextView
            android:id="@+id/widget_initials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/zt_widget_accent_circle"
            android:gravity="center"
            android:textColor="@color/zt_widget_on_accent"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium"/>
        <ImageView
            android:id="@+id/widget_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:importantForAccessibility="no"/>
    </FrameLayout>
    <TextView
        android:id="@+id/widget_label"
        style="@style/ZtWidget.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"/>
    <TextView
        android:id="@+id/widget_caption"
        style="@style/ZtWidget.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"/>
    <LinearLayout
        android:id="@+id/widget_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/widget_call"
            style="@style/ZtWidget.Action"
            android:src="@drawable/ic_zt_widget_call"
            android:contentDescription="@string/fw_call"/>
        <ImageView
            android:id="@+id/widget_message"
            android:layout_width="@dimen/zt_widget_action_size"
            android:layout_height="@dimen/zt_widget_action_size"
            android:layout_marginStart="16dp"
            android:background="@drawable/zt_widget_tile_circle"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_zt_widget_message"
            android:tint="@color/zt_widget_on_surface"
            android:contentDescription="@string/fw_message"/>
    </LinearLayout>
</LinearLayout>
