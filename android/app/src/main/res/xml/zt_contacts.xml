<?xml version="1.0" encoding="utf-8"?>
<!-- What contacts apps may edit on a ZT Contacts contact. Changes made
     there are pulled back into the vault the next time the app runs. The
     photo is left out: it is only changed in the vault. -->
<ContactsAccountType xmlns:android="http://schemas.android.com/apk/res/android">
    <EditSchema>
        <DataKind
            kind="name"
            maxOccurs="1"
            supportsDisplayName="true"
            supportsPrefix="false"
            supportsMiddleName="false"
            supportsSuffix="false"
            supportsPhoneticFamilyName="false"
            supportsPhoneticMiddleName="false"
            supportsPhoneticGivenName="false" />
        <DataKind kind="phone">
            <Type type="mobile" />
            <Type type="home" />
            <Type type="work" />
            <Type type="main" />
            <Type type="other" />
        </DataKind>
        <DataKind kind="email">
            <Type type="home" />
            <Type type="work" />
            <Type type="other" />
        </DataKind>
        <DataKind kind="organization" maxOccurs="1" />
        <DataKind kind="postal" needsStructured="false">
            <Type type="home" />
            <Type type="work" />
            <Type type="other" />
        </DataKind>
        <DataKind kind="note" maxOccurs="1" />
        <DataKind kind="event" dateWithTime="false">
            <Type type="birthday" maxOccurs="1" yearOptional="true" />
        </DataKind>
    </EditSchema>
</ContactsAccountType>
