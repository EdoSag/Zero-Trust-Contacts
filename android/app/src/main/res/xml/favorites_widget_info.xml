<?xml version="1.0" encoding="utf-8"?>
<!-- Favourites grid (W7): from 2x1 to the whole screen; more columns as it widens, scrolls when full. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="dev.sagron.zerotrustcontacts.FavoritesWidgetConfigureActivity"
    android:description="@string/fw_description"
    android:initialLayout="@layout/favorites_widget"
    android:previewLayout="@layout/favorites_widget_preview"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="90dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetFeatures="reconfigurable"
    android:widgetCategory="home_screen" />
