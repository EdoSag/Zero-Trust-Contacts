<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1 photo and name; wider shows the name beside the photo; from 2x2 a big
     photo with Call and Message buttons (W7). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="dev.sagron.zerotrustcontacts.ContactWidgetConfigureActivity"
    android:description="@string/contact_quick_widget_description"
    android:initialLayout="@layout/contact_quick_widget"
    android:previewLayout="@layout/contact_quick_widget_preview"
    android:minHeight="40dp"
    android:minWidth="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="1"
    android:updatePeriodMillis="0"
    android:widgetFeatures="reconfigurable"
    android:widgetCategory="home_screen" />
